# Initial HTTP host for this store only. Replace with nginx-https.conf.example
# after Certbot has issued this domain's certificate.
server {
    listen 80;
    listen [::]:80;
    server_name homeretreatdirect.com www.homeretreatdirect.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/home-retreat-direct-acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 120s;
        client_max_body_size 12m;
    }
}
