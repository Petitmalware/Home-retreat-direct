# Copy to /opt/home-retreat-direct/private/server.env on the VPS; chmod 600.
# Never commit, upload publicly, or paste the completed file into a chat.
HRD_ENV_FILE=/opt/home-retreat-direct/private/server.env
APP_PORT=3100
HRD_IMAGE=home-retreat-direct:current
HRD_TOOLS_IMAGE=home-retreat-direct-tools:current
# Generate separate 64-character hexadecimal values for each secret.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://hrd:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/home_retreat_direct
DIRECT_DATABASE_URL=postgresql://hrd:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/home_retreat_direct
DATABASE_TRANSPORT=pg
APP_ORIGIN=https://homeretreatdirect.com
ENCRYPTION_KEY=
JOB_SECRET=
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
INIT_PRODUCTION_CONFIRMED=homeretreatdirect.com
DEVELOPMENT_CATALOG=false
SHOW_DEMO_REVIEWS=false
SITES_RUNTIME=false
SITES_BUILD=false
# Durable uploads on this server (the Compose state volume).
LOCAL_MEDIA_ENABLED=true
LOCAL_MEDIA_DIRECTORY=/app/.local/media
# The server admin must configure the selected email provider; keep disabled
# until a test invoice and receipt have reached a controlled inbox.
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
EMAIL_FROM=Home Retreat Direct <orders@homeretreatdirect.com>
INFO_EMAIL=info@homeretreatdirect.com
ORDERS_EMAIL=orders@homeretreatdirect.com
SUPPORT_EMAIL=support@homeretreatdirect.com
# Confirm the host/port with the provider of these existing business mailboxes.
# Current domain MX points to Spacemail; do not change it to deploy the website.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_INFO_USER=info@homeretreatdirect.com
SMTP_INFO_PASS=
SMTP_ORDERS_USER=orders@homeretreatdirect.com
SMTP_ORDERS_PASS=
SMTP_SUPPORT_USER=support@homeretreatdirect.com
SMTP_SUPPORT_PASS=
# Optional Cloudinary storage instead of the persistent local media directory.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
