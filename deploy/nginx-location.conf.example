# Add inside ONLY homeretreatdirect.com's existing HTTPS virtual host.
# For a control panel, use its per-domain reverse-proxy/custom-location facility.
# Do not paste this over nginx.conf or a shared/default virtual host.
location / {
    proxy_pass http://127.0.0.1:3100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 120s;
    client_max_body_size 12m;
}
