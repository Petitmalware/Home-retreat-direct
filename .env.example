# Node.js 22.13+; copy to .env and supply your own values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# pg for ordinary PostgreSQL; http requires a Prisma Postgres direct connection URL.
DATABASE_TRANSPORT=pg
# Use the final HTTPS domain in production; canonical, sitemap, OG and JSON-LD URLs use this origin.
APP_ORIGIN=http://127.0.0.1:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Initial owner only. No default password is shipped.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
# Order workflow setting only: public SEO no longer depends on this flag.
DEVELOPMENT_CATALOG=true
SHOW_DEMO_REVIEWS=true
# Business contacts are public. SMTP passwords stay in the private environment.
INFO_EMAIL=info@homeretreatdirect.com
ORDERS_EMAIL=orders@homeretreatdirect.com
SUPPORT_EMAIL=support@homeretreatdirect.com
# smtp for existing mailboxes, or resend with verified senders.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
EMAIL_FROM=Home Retreat Direct <orders@homeretreatdirect.com>
EMAIL_INFO_FROM=Home Retreat Direct <info@homeretreatdirect.com>
EMAIL_ORDERS_FROM=Home Retreat Direct <orders@homeretreatdirect.com>
EMAIL_SUPPORT_FROM=Home Retreat Direct <support@homeretreatdirect.com>
# Confirm with the mailbox provider. Spacemail uses mail.spacemail.com / 465 / SSL.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_INFO_USER=info@homeretreatdirect.com
SMTP_INFO_PASS=
SMTP_ORDERS_USER=orders@homeretreatdirect.com
SMTP_ORDERS_PASS=
SMTP_SUPPORT_USER=support@homeretreatdirect.com
SMTP_SUPPORT_PASS=
# Generic SMTP_USER / SMTP_PASS are optional fallbacks for a provider with aliases.
# Keep disabled while preparing templates. Enable after verifying the sender and public domain.
EMAIL_DELIVERY_ENABLED=false
# For a VPS, use a durable directory/volume. See deploy/server.env.example.
LOCAL_MEDIA_ENABLED=false
LOCAL_MEDIA_DIRECTORY=
# Cloudinary images and purchased-item review photos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional authenticated external outbox cron POST /api/jobs/email.
JOB_SECRET=
# Hosted build settings; do not set for normal local dev.
SITES_RUNTIME=false
HOSTED_APP_ORIGIN=https://home-retreat-direct.nearbykidd.chatgpt.site
# For browser tests: chrome, msedge, or omit the channel on a provisioned browser install.
PLAYWRIGHT_CHANNEL=chrome
RUN_INTEGRATION=false
